{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "site-config.js",
        "pet-i18n.js",
        "pet-focus.js",
        "pet-geometry.js",
        "pet-mischief.js",
        "pet-shortcuts.js",
        "pet-runtime.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [],
      "js": [
        "site-config.js",
        "demo-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
